<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LippoLand.Soap.Tests</AssemblyName>
    <RootNamespace>LippoLand.Soap.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- CoreWCF needed because IOnlineBookingService uses [ServiceContract]/[OperationContract] -->
    <PackageReference Include="CoreWCF.Http"       Version="1.*" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bring in the client source files directly (no project reference) -->
    <Compile Include="../LippoLand.Soap.Client/SoapEnvelopes.cs" />
    <Compile Include="../LippoLand.Soap.Client/SoapHttpClient.cs" />
    <!-- Bring in the service source files for server-side span tests -->
    <Compile Include="../LippoLand.Soap.Service/InstanaSpan.cs" />
    <Compile Include="../LippoLand.Soap.Service/IOnlineBookingService.cs" />
    <Compile Include="../LippoLand.Soap.Service/OnlineBookingService.cs" />
  </ItemGroup>

</Project>
