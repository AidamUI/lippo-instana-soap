<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LippoLand.Soap.Tests</AssemblyName>
    <RootNamespace>LippoLand.Soap.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      No NuGet packages needed — the Instana SDK is stubbed by InstanaStub.cs
      so tests compile and run without the agent being present.
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- Bring in the client source files directly (no project reference) -->
    <Compile Include="../LippoLand.Soap.Client/SoapEnvelopes.cs" />
    <Compile Include="../LippoLand.Soap.Client/SoapHttpClient.cs" />
  </ItemGroup>

</Project>
