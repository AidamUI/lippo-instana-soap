<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!--
    Install via NuGet Package Manager Console (inside Visual Studio):
      Install-Package Instana.ManagedTracing.Sdk -Project LippoLand.Soap.Client

    This will pull in both:
      Instana.ManagedTracing.Sdk
      Instana.ManagedTracing.Api  (dependency, installed automatically)
  -->
  <package id="Instana.ManagedTracing.Sdk" version="1.*" targetFramework="net40" />
</packages>
