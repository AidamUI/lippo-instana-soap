<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LippoLand.Soap.Client</AssemblyName>
    <RootNamespace>LippoLand.Soap.Client</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!--
    No NuGet packages needed.
    Instana tracing is done via the agent's local REST API (port 42699).
    The agent must be running on the same host.
    Docs: https://www.ibm.com/docs/en/instana-observability?topic=features-net-tracing-sdk
  -->

</Project>
