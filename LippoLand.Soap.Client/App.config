<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <appSettings>
    <!-- ── Local stub (default) ─────────────────────────────────────────── -->
    <add key="ServiceUrl" value="http://localhost:8080/OnlineBooking"/>

    <!-- ── Real LippoLand backend (uncomment to test against live service) ─
    <add key="ServiceUrl" value="https://connect.lippoland.id/InternalMobileAppsService/WS_OnlineBooking.asmx"/>
    -->

    <!-- ── Auth credentials for SOAP AuthHeader ─────────────────────────── -->
    <!-- Replace with real credentials before pointing at production -->
    <add key="AuthDomain"   value="LIPPOLAND"/>
    <add key="AuthUser"     value="demo_user"/>
    <add key="AuthPassword" value="demo_pass"/>
  </appSettings>
</configuration>
