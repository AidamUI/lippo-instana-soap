<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LippoLand.Soap.Monolith</AssemblyName>
    <RootNamespace>LippoLand.Soap.Monolith</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- CoreWCF: hosts the SOAP service inside this same process -->
    <PackageReference Include="CoreWCF.Http"       Version="1.*" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Re-use the SOAP contract + implementation from the Service project.
      Re-use SoapHttpClient (WITH instrumentation) from the Client project.
      Re-use SoapEnvelopes from the Client project.
    -->
    <Compile Include="../LippoLand.Soap.Service/IOnlineBookingService.cs" />
    <Compile Include="../LippoLand.Soap.Service/OnlineBookingService.cs" />
    <Compile Include="../LippoLand.Soap.Client/SoapHttpClient.cs" />
    <Compile Include="../LippoLand.Soap.Client/SoapEnvelopes.cs" />
  </ItemGroup>

</Project>
